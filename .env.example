# Copy this file to .env and fill in your own values.
# An OpenWeatherMap API key is required - see https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here
OPENWEATHER_UNITS=metric
PORT=3000

# Public hostname/IP that VPN clients should connect to. "auto" lets the
# wireguard container detect it, which is fine on a single machine but
# should be set explicitly (your server's public IP or a DDNS hostname)
# for a real deployment.
VPN_SERVER_URL=auto
